# نمونه تنظیمات برای سرور (Production)
# این فایل را کپی کنید به .env و مقادیر را پر کنید

NODE_ENV=production
# Production kaya.fxguard.io (سرور مشترک): PORT=3202 — tenant تکی: 3002
PORT=3202

# با true فقط SQLite استفاده می‌شود (ساده؛ بدون PostgreSQL)
USE_SQLITE=true

# کلید JWT — حتماً یک رشته طولانی و تصادفی بگذارید
JWT_SECRET=change-this-to-a-long-random-string-in-production

# آدرس‌های مجاز برای CORS (با کاما جدا) — حتماً تمام دامنه‌ها و ساب‌دامین‌ها را اضافه کنید
# Socket.IO هم از همین لیست استفاده می‌کند
# CORS_ORIGINS=https://kaya.fxguard.io
CORS_ORIGINS=https://kaya.fxguard.io
FRONTEND_URL=https://kaya.fxguard.io
# لینک صفحه فروش پلن‌ها
# SALES_URL=https://kaya.fxguard.io

# Production kaya.fxguard.io: http://127.0.0.1:3201 (پورت 3001 روی همان سرور = حسابداری)
GATEWAY_URL=http://127.0.0.1:3201

# اختیاری: PostgreSQL (اگر USE_SQLITE=false)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=whatsapp_crm
# DB_USER=crm_user
# DB_PASSWORD=your_secure_password

# اختیاری: Redis
# REDIS_URL=redis://localhost:6379

# پوش نوتیفیکیشن کارکنان (FCM)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/kaya/firebase-service-account.json

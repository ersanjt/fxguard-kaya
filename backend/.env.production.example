# نمونه تنظیمات برای سرور (Production)
# این فایل را کپی کنید به .env و مقادیر را پر کنید

NODE_ENV=production
PORT=3002

# با true فقط SQLite استفاده می‌شود (ساده؛ بدون PostgreSQL)
USE_SQLITE=true

# کلید JWT — حتماً یک رشته طولانی و تصادفی بگذارید
JWT_SECRET=change-this-to-a-long-random-string-in-production

# آدرس‌های مجاز برای CORS (با کاما جدا)
# اگر با IP کار می‌کنید: http://92.205.58.83,http://92.205.58.83:3002
# اگر دامنه دارید: https://yourdomain.com
CORS_ORIGINS=http://92.205.58.83,http://92.205.58.83:3002
FRONTEND_URL=http://92.205.58.83

# آدرس Gateway واتساپ (اگر روی همین سرور است)
GATEWAY_URL=http://127.0.0.1:3001

# اختیاری: PostgreSQL (اگر USE_SQLITE=false)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=whatsapp_crm
# DB_USER=crm_user
# DB_PASSWORD=your_secure_password

# اختیاری: Redis
# REDIS_URL=redis://localhost:6379

      "fields": [
        { "key": "tour_name", "type": "text", "labels": { "fa": "تور / مقصد", "en": "Tour / destination", "tr": "Tur / varış" }, "required": true, "isTitle": true, "searchable": true },
        { "key": "travel_date", "type": "date", "labels": { "fa": "تاریخ سفر", "en": "Travel date", "tr": "Seyahat tarihi" } },
        { "key": "pax", "type": "number", "labels": { "fa": "تعداد نفرات", "en": "Passengers", "tr": "Kişi sayısı" }, "validation": { "min": 1, "max": 200 }, "defaultValue": 1 },
        { "key": "total", "type": "money", "labels": { "fa": "مبلغ کل", "en": "Total", "tr": "Toplam" } },
        { "key": "paid", "type": "money", "labels": { "fa": "پرداخت‌شده", "en": "Paid", "tr": "Ödenen" } },
        { "key": "hotel", "type": "text", "labels": { "fa": "هتل", "en": "Hotel", "tr": "Otel" } },
        { "key": "visa_needed", "type": "boolean", "labels": { "fa": "نیاز به ویزا", "en": "Visa needed", "tr": "Vize gerekli" } },
        { "key": "notes", "type": "textarea", "labels": { "fa": "یادداشت", "en": "Notes", "tr": "Notlar" }, "showInList": false }
      ]

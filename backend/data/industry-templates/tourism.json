        { "key": "deposit", "labels": { "fa": "بیعانه", "en": "Deposit paid", "tr": "Kapora" }, "color": "#f59e0b" },
        { "key": "confirmed", "labels": { "fa": "قطعی", "en": "Confirmed", "tr": "Onaylandı" }, "color": "#22c55e" },
        { "key": "travelled", "labels": { "fa": "سفر انجام شد", "en": "Travelled", "tr": "Seyahat edildi" }, "color": "#0ea5e9", "isFinal": true },
        { "key": "cancelled", "labels": { "fa": "لغو", "en": "Cancelled", "tr": "İptal" }, "color": "#94a3b8", "isFinal": true }

        { "key": "details", "type": "textarea", "labels": { "fa": "شرح", "en": "Details", "tr": "Ayrıntı" }, "showInList": false },
        { "key": "rating", "type": "number", "labels": { "fa": "امتیاز (۱ تا ۵)", "en": "Rating (1–5)", "tr": "Puan (1–5)" }, "validation": { "min": 1, "max": 5 } }

{
  "name": "fxguard-kaya-backend",
  "version": "1.1.0",
  "description": "fxguard-kaya — backend API and staff portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",

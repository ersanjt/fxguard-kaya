    "seed": "node seed-admin.js",
    "test": "node tests/suite.test.js",
    "test:suite": "node tests/suite.test.js",
    "test:integration": "node tests/integration.test.js",
    "test:unit": "node tests/api-customers-notes.test.js",
    "test:all": "node tests/suite.test.js && node tests/integration.test.js",
    "avatars:backfill": "node scripts/backfill-customer-avatars.js",

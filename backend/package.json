  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "amqplib": "^0.10.3",
    "axios": "^1.8.4",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.5.0",
    "excel4node": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "geoip-lite": "^1.4.10",

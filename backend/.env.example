# دیتابیس: با true فقط SQLite استفاده می‌شود (بدون PostgreSQL)
USE_SQLITE=true
PORT=3002
NODE_ENV=development

# ==================== امنیت (الزامی) ====================
# کلید JWT — حداقل ۳۲ کاراکتر — تولید: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-char-string-minimum

# کلید رمزنگاری ایمیل شرکتی (جداگانه از JWT) — الزامی — تولید: openssl rand -hex 32
# باید با JWT_SECRET متفاوت باشد
ENCRYPT_SECRET=change-this-to-another-random-32-char-string

# کلید احراز هویت Webhook (باید با WEBHOOK_SECRET در Gateway یکسان باشد)
# تولید: openssl rand -hex 32
WEBHOOK_SECRET=change-this-to-a-random-webhook-secret

# ادمین‌های اصلی — ایمیل‌ها با کاما جدا (الزامی)
MAIN_ADMIN_EMAIL=admin@your-domain.com
MAIN_ADMIN_PASSWORD=change-this-to-a-strong-password

# مبداهای مجاز CORS (با کاما جدا کنید)
# در production حتماً دامنه اصلی را اضافه کنید
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://kaya.fxguard.io,https://www.kaya.fxguard.io
# در NODE_ENV غیر از production مبداهای رایج dev (مثل Vite روی 5173) خودکار به لیست اضافه می‌شوند.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
FRONTEND_URL=http://localhost:3000
# آدرس Gateway واتساپ (برای QR و ارسال پیام؛ هنگام استفاده از Cloud API فقط برای status/QR)
GATEWAY_URL=http://localhost:3001
# آدرس عمومی Backend — برای ارسال پیام صوتی و فایل، Gateway باید بتواند این URL را فراخوانی کند
# روی یک ماشین: http://localhost:3002 | در production: https://api.example.com
# BACKEND_PUBLIC_URL=http://localhost:3002
# کلید امنیتی Gateway — باید با GATEWAY_API_SECRET در Gateway یکسان باشد (حداقل ۳۲ کاراکتر)
# تولید: openssl rand -hex 32
# GATEWAY_API_SECRET=
# پشتیبانی ورود و پاسخ AI: برای ارجاع مشتری به کارشناس (صفحه ورود + پاسخ‌های هوش مصنوعی)
# SUPPORT_EMAIL=support@kaya.fxguard.io
# SUPPORT_URL=https://wa.me/905010676486
# SALES_URL=/contact

# ==================== به‌روزرسانی اپ اندروید (از داخل اپ) ====================
# اپ با GET /api/config مقدار androidAppUpdate را می‌خواند.
# با دیپلوی GitHub Actions (/.github/workflows/deploy.yml) این متغیرها از build.gradle.kts و APK روی دیسک هماهنگ می‌شوند.
# دستی: ANDROID_APP_VERSION_CODE باید از versionCode نصب‌شده روی گوشی بزرگ‌تر باشد تا آپدیت پیشنهاد شود.
# ANDROID_APP_APK_URL: یا URL کامل https، یا مسیر نسبی (با BACKEND_PUBLIC_URL=https://... به https مطلق تبدیل می‌شود):
#   ANDROID_APP_APK_URL=/uploads/releases/app-release.apk
# BACKEND_PUBLIC_URL برای مسیر نسبی APK توصیه می‌شود (https). اگر نباشد، /api/config از Host + HTTPS درخواست (مثل X-Forwarded-Proto) حدس می‌زند.
# ANDROID_APP_UPDATE_MANDATORY=true یعنی کاربر بدون به‌روزرسانی نمی‌تواند ادامه دهد.
# ANDROID_APP_RELEASE_NOTES=رفع باگ و بهبود پایداری
# ANDROID_APP_VERSION_CODE=7
# ANDROID_APP_VERSION_NAME=1.4.2
# ANDROID_APP_APK_URL=/uploads/releases/app-release.apk
# ANDROID_APP_UPDATE_MANDATORY=false

# دامنه‌هایی که / به /dashboard ریدایرکت می‌شوند (با کاما جدا). kaya.fxguard.io = دامنه پنل
# REDIRECT_ROOT_TO_DASHBOARD_HOSTS=kaya.fxguard.io

# سقف حجم آپلود APK/IPA از «ظاهر پنل» به ازای هر فایل (مگابایت؛ پیش‌فرض ۲۰۰)
# MOBILE_BUILD_UPLOAD_MAX_MB=200

# SMTP برای kaya.fxguard.io — راهنما: backend/docs/EMAIL-SETUP-FXGUARD.md
# cPanel: SMTP_HOST=mail.kaya.fxguard.io | GoDaddy Email: SMTP_HOST=smtpout.secureserver.net
# SMTP_HOST=mail.kaya.fxguard.io
# SMTP_PORT=587
# SMTP_USER=noreply@kaya.fxguard.io
# SMTP_PASS=
# SMTP_FROM=noreply@kaya.fxguard.io
# SMTP_FROM_NAME=پورتال کارکنان
# SMTP_SECURE=false
# EMAIL_LOGIN_NOTIFICATION=false
# در صورت Connection timeout: پورت ۴۶۵ با SMTP_SECURE=true امتحان کنید؛ یا زمان‌انتظار را افزایش دهید:
# EMAIL_CONNECTION_TIMEOUT_MS=25000
# EMAIL_GREETING_TIMEOUT_MS=15000
# EMAIL_SOCKET_TIMEOUT_MS=25000
# ایمیل بازیابی رمز: زمان‌انتظار کوتاه‌تر تا درخواست HTTP و UI قفل نشوند (پیش‌فرض‌ها زیر کافی‌اند)
# EMAIL_FORGOT_MAX_RETRIES=1
# EMAIL_FORGOT_CONNECTION_TIMEOUT_MS=10000
# EMAIL_FORGOT_GREETING_TIMEOUT_MS=7000
# EMAIL_FORGOT_SOCKET_TIMEOUT_MS=10000
# اگر فقط همان پورت/secure تنظیم‌شده را بزند و بقیهٔ ترکیب‌ها را امتحان نکند، پیش‌فرض همین است؛ برای امتحان همهٔ ترکیب‌ها مثل سایر ایمیل‌ها:
# EMAIL_FORGOT_TRY_ALL_SMTP_COMBOS=1
# اگر mail.kaya.fxguard.io با ۵۸۷ کار نکرد، hostهای جایگزین (با کاما جدا) برای تست ارسال:
# SMTP_FALLBACK_HOSTS=smtpout.secureserver.net,143.182.205.92.host.secureserver.net
# ایمیل دریافت فرم تماس لندینگ (پیش‌فرض: sales@kaya.fxguard.io)
# CONTACT_EMAIL=sales@kaya.fxguard.io

# اعلان‌های امنیتی مدیر (ایمیل + تلگرام)
# رویدادها: login_success, login_failed, logout
# ADMIN_ALERTS_ENABLED=true
# ADMIN_ALERT_EMAILS=admin@kaya.fxguard.io,owner@kaya.fxguard.io
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=123456789,987654321
# TELEGRAM_TIMEOUT_MS=12000
# نام کاربری بات (بدون @) برای ساخت لینک مستقیم اتصال از پنل
# TELEGRAM_BOT_USERNAME=kayacrm_bot
# PM2 cluster: فقط worker شماره ۰ long polling می‌زند. برای غیرفعال کردن این رفتار (توصیه نمی‌شود):
# TELEGRAM_POLL_ALL_WORKERS=1
# خاموش کردن کامل long polling بات (فقط ارسال اعلان‌ها از API sendMessage):
# TELEGRAM_POLLING_DISABLED=1
# ساعت ارسال روزانه نرخ ارز (پیش‌فرض: ۹ صبح)
# DAILY_RATES_HOUR=9
# DAILY_RATES_MINUTE=0

# اعلان خطاهای runtime فرانت/بک‌اند به مدیر
# (از همان ADMIN_ALERT_EMAILS و TELEGRAM_* استفاده می‌کند)
# CLIENT_ERROR_REPORTING_ENABLED=true

# نرخ ارز — API ناواسان برای دریافت نرخ لحظه‌ای (اختیاری)
# دریافت کلید رایگان از: https://navasan.tech
# بدون این کلید: نرخ‌ها نمایش داده نمی‌شوند ولی می‌توانید نرخ ثابت دستی تنظیم کنید
# NAVASAN_API_KEY=your-navasan-api-key-here

# OpenAI — برای مسیریابی هوشمند به دپارتمان و پاسخ خودکار هوش مصنوعی
# دریافت کلید از: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_ANSWER_ENABLED=true
# مدل: gpt-4o-mini | gpt-4o | ...
# OPENAI_MODEL=gpt-4o-mini
# AI_MAX_RESPONSE_TOKENS=500
# AI_TEMPERATURE=0.4
# AI_REQUEST_TIMEOUT_MS=20000
# AI_COMPANY_KNOWLEDGE_JSON={"ceo":"...","offices":{...}}  — اختیاری، برای بازنویسی backend/config/companyKnowledge.js

# ============================================================
# WhatsApp Business Cloud API (Meta)
# برای استفاده بدون Gateway/QR — از Meta for Developers دریافت کنید
# ============================================================
# کاربر CRM برای پیام‌های ارسالی از اپ واتساپ روی موبایل (مالک خط — Ali / مدیرعامل)
# WHATSAPP_MOBILE_USER_ID=
# WHATSAPP_MOBILE_USER_EMAIL=aliaksu754@gmail.com
# WHATSAPP_MOBILE_USER_USERNAME=
# WHATSAPP_MOBILE_USER_EMAILS=   # چند ایمیل با کاما (اختیاری)
# پیشوند نام کوتاه کارشناس در هر پیام CRM به مشتری — «E. Tabrizi: متن» (0 = خاموش)
# WHATSAPP_OUTBOUND_STAFF_PREFIX=1
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# توکن تأیید وب‌هوک — در Meta App > Webhooks > Verify Token وارد کنید
# WHATSAPP_CLOUD_VERIFY_TOKEN=
# App Secret متا برای اعتبارسنجی X-Hub-Signature-256 وب‌هوک (الزامی برای امنیت)
# WHATSAPP_CLOUD_APP_SECRET=
# قالب پیش‌فرض ارسال انبوه (باید در Meta Business تأیید شده باشد)
# WHATSAPP_CLOUD_BULK_TEMPLATE_NAME=
# WHATSAPP_CLOUD_OUTBOUND_TEMPLATE_NAME=
# WHATSAPP_CLOUD_SESSION_HOURS=24

# ============================================================
# زیرساخت — Redis و RabbitMQ (اختیاری؛ اگر استفاده می‌کنید)
# ============================================================
# ذخیره session، rate-limit و cache
# REDIS_URL=redis://localhost:6379

# صف پیام‌ها برای Gateway
# RABBITMQ_URL=amqp://localhost:5672

# MongoDB — فقط در صورت USE_SQLITE=false و نیاز به بعضی قابلیت‌ها
# MONGODB_URL=mongodb://localhost:27017/kayacrm

# تنظیمات منطقه زمانی (پیش‌فرض: Asia/Tehran)
# APP_TIMEZONE=Asia/Tehran

# حداکثر اتصال‌های همزمان دیتابیس
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_POOL_ACQUIRE_MS=30000
# DB_POOL_IDLE_MS=10000

# سقف درخواست API کارکنان برای هر مرورگر واردشده در ۱۵ دقیقه (پیش‌فرض ۱۲۰۰۰)
# API_RATE_LIMIT_MAX=12000
# API_RATE_LIMIT_WINDOW_MS=900000
# غیرفعال کردن Rate Limit (فقط در محیط توسعه)
# DISABLE_RATE_LIMIT=false

# پوش نوتیفیکیشن کارکنان (FCM) — JSON سرویس‌اکانت Firebase
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# یا مسیر فایل روی سرور:
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/kaya/firebase-service-account.json

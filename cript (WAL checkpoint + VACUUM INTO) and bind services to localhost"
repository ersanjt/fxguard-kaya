[32m+[m[32m        const buf = Buffer.from(res.data);[m
[32m+[m[32m        const ct = (res.headers['content-type'] || '').split(';')[0].trim().toLowerCase();[m
[32m+[m[32m        const suggestedName = media.filename || media.caption || 'file';[m
[32m+[m[32m        let ext = (path.extname(suggestedName) || '').toLowerCase();[m
[32m+[m[32m        if (!ext && ct) {[m
[32m+[m[32m            if (ct.includes('image/jpeg') || ct.includes('image/jpg')) ext = '.jpg';[m
[32m+[m[32m            else if (ct.includes('image/png')) ext = '.png';[m
[32m+[m[32m            else if (ct.includes('image/gif')) ext = '.gif';[m
[32m+[m[32m            else if (ct.includes('image/webp')) ext = '.webp';[m
[32m+[m[32m            else if (ct.includes('video/')) ext = '.mp4';[m
[32m+[m[32m            else if (ct.includes('audio/')) ext = '.mp3';[m
[32m+[m[32m            else if (ct.includes('pdf')) ext = '.pdf';[m

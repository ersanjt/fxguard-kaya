[32m+[m[32m        const safeName = (Date.now() + '-' + suggestedName.replace(/[^a-zA-Z0-9._-]/g, '_').slice(0, 100)) + (ext.startsWith('.') ? ext : '.' + ext);[m
[32m+[m[32m        const filePath = path.join(uploadsDir, safeName);[m

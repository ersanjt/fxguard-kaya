[32m+[m[32m    if (!media || !media.url) return media;[m
[32m+[m[32m    const url = (media.url || '').trim();[m
[32m+[m[32m    if (!url.startsWith('http://') && !url.startsWith('https://')) {[m
[32m+[m[32m        if (url.startsWith('/') && (url.startsWith('/uploads/') || url.includes('uploads')))[m
[32m+[m[32m            return { url: url, filename: media.filename || media.caption, mimetype: media.mimetype };[m
[32m+[m[32m        return media;[m
[32m+[m[32m    }[m
[32m+[m[32m    try {[m
[32m+[m[32m        const res = await axios.get(url, {[m
[32m+[m[32m            responseType: 'arraybuffer',[m
[32m+[m[32m            timeout: 30000,[m
[32m+[m[32m            maxContentLength: 20 * 1024 * 1024,[m
[32m+[m[32m            maxRedirects: 5,[m
[32m+[m[32m            headers: { 'User-Agent': 'KayaCRM-Backend/1.0', 'Accept': 'image/*,video/*,audio/*,*/*' }[m
[32m+[m[32m        });[m

# نمونهٔ nginx برای app.fxguard.io و پنل‌های خودخدمت
# کپی روی سرور: /etc/nginx/sites-available/app-fxguard
# گواهی wildcard (DNS-01) لازم است: *.app.fxguard.io
# این فایل را روی kaya.fxguard.io اعمال نکنید.

upstream fxguard_app_backend {
    server 127.0.0.1:3002;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.fxguard.io *.app.fxguard.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.fxguard.io *.app.fxguard.io;

    # certbot certonly --dns-<provider> -d app.fxguard.io -d '*.app.fxguard.io'
    ssl_certificate     /etc/letsencrypt/live/app.fxguard.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.fxguard.io/privkey.pem;

    client_max_body_size 64M;

    location / {
        proxy_pass http://fxguard_app_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# دامنهٔ اختصاصی مشتری بعد از CNAME به {slug}.app.fxguard.io:
# یک server_name جدا با گواهی همان دامنه، همان proxy_pass به 3002.
# Host باید دامنهٔ مشتری بماند تا middleware tenant آن را پیدا کند.

# پورت سرور Gateway
PORT=3001
NODE_ENV=development

# واتساپ (سشن و کلاینت)
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_CLIENT_ID=enterprise-crm

# Redis (برای وضعیت و QR؛ اختیاری)
REDIS_URL=redis://localhost:6379

# RabbitMQ (برای صف پیام؛ اختیاری - در صورت نبودن از HTTP به Backend استفاده می‌شود)
RABBITMQ_URL=amqp://localhost:5672

# آدرس Backend برای ارسال پیام‌های دریافتی (وب‌هوک)
# در پروداکشن: https://kaya.fxguard.io یا آدرس واقعی Backend
BACKEND_API_URL=http://localhost:3002

# فرانت (برای CORS)
FRONTEND_URL=http://localhost:3000

# کلید امنیتی — باید با GATEWAY_API_SECRET در Backend یکسان باشد
# GATEWAY_API_SECRET=your-random-secret-key

# اتصال مجدد خودکار پس از قطعی (پیش‌فرض: فعال)
# WHATSAPP_AUTO_RECONNECT=false
# WHATSAPP_RECONNECT_DELAY_MS=15000

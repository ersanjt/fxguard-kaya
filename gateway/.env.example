# ============================================================
# WhatsApp Gateway — تنظیمات
# کپی به .env و مقادیر را تنظیم کنید
# ============================================================

# --- سرور ---
# هرگز 3002 نگذارید — آن پورت مال Backend است؛ تداخل باعث کرش و EADDRINUSE می‌شود.
PORT=3001
NODE_ENV=development

# --- واتساپ (سشن و کلاینت) ---
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_CLIENT_ID=enterprise-crm
# none = عدم استفاده از کش نسخه وب (رفع خطای QR بی‌اعتبار)
WHATSAPP_WEB_VERSION_CACHE=none

# --- Redis (برای وضعیت و QR؛ اختیاری) ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ (برای صف پیام؛ اختیاری) ---
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_INCOMING_QUEUE=whatsapp_messages
RABBITMQ_OUTGOING_QUEUE=outgoing_messages

# --- Backend ---
BACKEND_API_URL=http://localhost:3002

# --- CORS ---
# چند مبدأ با ویرگول (مثلاً Vite روی 5173 + پنل روی بک‌اند 3002)
FRONTEND_URL=http://localhost:3000,http://localhost:3002,http://localhost:5173

# ============================================================
# امنیت (Production: حتماً تنظیم کنید)
# ============================================================

# کلید امنیتی — باید با GATEWAY_API_SECRET در Backend یکسان باشد
# حداقل ۳۲ کاراکتر تصادفی پیشنهاد می‌شود
# مثال: openssl rand -hex 32
# GATEWAY_API_SECRET=

# ============================================================
# اتصال مجدد خودکار
# ============================================================

# فعال/غیرفعال (پیش‌فرض: true)
# WHATSAPP_AUTO_RECONNECT=true

# تأخیر اولیه قبل از اولین تلاش (میلی‌ثانیه)
# WHATSAPP_RECONNECT_DELAY_MS=15000

# حداکثر تعداد تلاش برای اتصال مجدد
# WHATSAPP_RECONNECT_MAX_RETRIES=10

# ضریب افزایش تأخیر (exponential backoff)
# تلاش ۱: 15s، تلاش ۲: 22.5s، تلاش ۳: 33.7s، ...
# WHATSAPP_RECONNECT_BACKOFF=1.5

# ============================================================
# Rate Limiting
# ============================================================

# API عمومی: حداکثر درخواست در بازه زمانی
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200

# ارسال پیام: حداکثر پیام در دقیقه (HTTP + صف RabbitMQ OUTGOING_QUEUE)
# SEND_LIMIT_WINDOW_MS=60000
# SEND_LIMIT_MAX=60

# ============================================================
# وب‌هوک Backend
# ============================================================

# تعداد تلاش برای ارسال پیام به Backend
# BACKEND_WEBHOOK_RETRIES=5

# تأخیر پایه بین تلاش‌ها (میلی‌ثانیه)
# BACKEND_WEBHOOK_RETRY_DELAY_MS=2000

# ============================================================
# Media URL (امنیت)
# ============================================================

# لیست دامنه‌های مجاز برای URL مدیا (با کاما جدا)
# خالی = فقط SSRF block (رد localhost و IPهای خصوصی)
# مثال: cdn.example.com,storage.googleapis.com
# MEDIA_URL_WHITELIST=

# اجازه localhost برای رسانه (پیام صوتی و فایل) — در development خودکار فعال است
# در production اگر backend و gateway روی یک ماشین هستند: MEDIA_ALLOW_LOCALHOST=true
# MEDIA_ALLOW_LOCALHOST=true

# ============================================================
# سایر
# ============================================================

# مسیر ذخیره فایل‌های آپلود شده
# UPLOADS_DIR=./uploads

# سطح لاگ: error, warn, info, debug
# LOG_LEVEL=info

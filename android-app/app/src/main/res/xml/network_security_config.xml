<?xml version="1.0" encoding="utf-8"?>
<!-- ترافیک رمزگذاری‌شده پیش‌فرض؛ cleartext در بیلد debug با manifest جدا فعال می‌شود -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

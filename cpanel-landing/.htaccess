# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ========== URL Rewrites & Redirects ==========
RewriteEngine On
RewriteBase /

# /contact -> contact.html (SEO-friendly URL)
RewriteRule ^contact$ contact.html [L,QSA]

# Optional: redirect /dashboard to app subdomain (uncomment if CRM runs on app.fxguard.io)
# RewriteCond %{REQUEST_URI} ^/dashboard
# RewriteRule ^dashboard(.*)$ https://app.fxguard.io$1 [R=302,L]

# ========== Force HTTPS (recommended for SEO & security) ==========
# SSL active - redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ========== Security & Performance ==========
# HSTS - Force HTTPS for 1 year (only when HTTPS is on)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# Prevent directory listing
Options -Indexes

# Protect .htaccess and sensitive files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Cache static assets (1 month)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Gzip compression (if available)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

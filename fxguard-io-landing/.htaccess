

# ========== Domain Structure ==========
# fxguard.io (root) = Marketing site (5 languages + market landings)
# app.fxguard.io = CRM Panel (subdomain)

# Performance + SEO defaults
DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Prefer apex (non-www)
  RewriteCond %{HTTP_HOST} ^www\.fxguard\.io$ [NC]
  RewriteRule ^(.*)$ https://fxguard.io/$1 [L,R=301]

  # SEO-friendly clean URLs (preserve query string / lang)
  RewriteRule ^contact/?$ contact.html [L,QSA]
  RewriteRule ^whatsapp-crm/?$ whatsapp-crm.html [L,QSA]
  RewriteRule ^pricing/?$ pricing.html [L,QSA]
  RewriteRule ^products/?$ products.html [L,QSA]
  RewriteRule ^self-hosted/?$ self-hosted.html [L,QSA]
  RewriteRule ^managed-hosting/?$ managed-hosting.html [L,QSA]
  RewriteRule ^live-demo/?$ live-demo.html [L,QSA]
  RewriteRule ^pay/?$ pay.html [L,QSA]
  RewriteRule ^procurement/?$ procurement.html [L,QSA]
  RewriteRule ^blog/?$ blog.html [L,QSA]
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog/$1.html [L,QSA]

  # Pretty 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule .+ /404.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ========== Security headers ==========
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # HTML: short cache, always revalidate (content updates often)
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Static assets: long cache
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf|otf|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Keep XML / robots fresh enough for crawlers
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Cache static assets (Expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json application/ld+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Keep ETags stable with Apache FileETag defaults on most hosts
FileETag MTime Size

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2

# Prefer HTTPS for protocol-relative / mixed content edge cases
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ==================== WhatsApp Gateway Configuration ====================
GATEWAY_PORT=3001
GATEWAY_NODE_ENV=production

# WhatsApp Session
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_CLIENT_ID=enterprise-crm

# ==================== Backend Configuration ====================
# پورت API (همان PORT در backend/.env) — برای پروکسی Vite در frontend
BACKEND_PORT=3002
BACKEND_NODE_ENV=production

# ==================== Database Configuration ====================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_crm
DB_USER=crm_user
DB_PASSWORD=ChangeThisStrongPassword123!

# MongoDB
MONGODB_URL=mongodb://localhost:27017/whatsapp_crm

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=ChangeThisRedisPassword123!

# ==================== Message Queue ====================
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=ChangeThisRabbitMQPassword123!

# ==================== Security ====================

# ادمین اصلی — ایمیل‌هایی با دسترسی کامل (با کاما جدا کنید). خالی = پیش‌فرض Admin@kaya.fxguard.io
# MAIN_ADMIN_EMAIL=admin@kaya.local

# JWT Settings
JWT_SECRET=ChangeThisToAVeryLongAndRandomSecretKey123456789!
JWT_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=ChangeThisSessionSecretKey123456789!

# Encryption
ENCRYPTION_KEY=ChangeThisEncryptionKey32Characters!

# ==================== URLs ====================
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:3002
GATEWAY_URL=http://localhost:3001

# نوار قیمت ارز در داشبورد (نوسان دات نت / api.navasan.tech)
NAVASAN_API_KEY=premVIlUQHLNK4IGQzHnZNZyHCbJrknc

# Production URLs (uncomment for production)
# FRONTEND_URL=https://crm.yourcompany.com
# BACKEND_API_URL=https://api.crm.yourcompany.com
# GATEWAY_URL=https://gateway.crm.yourcompany.com

# ==================== Email Configuration (Optional) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=WhatsApp CRM <noreply@yourcompany.com>

# ==================== File Upload ====================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ==================== Rate Limiting ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== WhatsApp Bulk Messaging ====================
BULK_SEND_DELAY_MS=5000
BULK_MAX_RECIPIENTS=100

# ==================== Auto-Response ====================
AUTO_RESPONSE_ENABLED=true
AUTO_RESPONSE_DELAY_MS=2000

# ==================== Logging ====================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# ==================== Backup ====================
BACKUP_ENABLED=true
BACKUP_PATH=/backups/whatsapp-crm
BACKUP_SCHEDULE=0 2 * * *

# ==================== Monitoring ====================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

GRAFANA_ENABLED=true
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPassword!

# ==================== Features ====================
ENABLE_BULK_MESSAGING=true
ENABLE_AUTO_RESPONSE=true
ENABLE_AUTO_ASSIGNMENT=true
ENABLE_FILE_UPLOAD=true
ENABLE_VOICE_MESSAGE=true
ENABLE_VIDEO_CALL=false
ENABLE_CHATBOT=false

# ==================== Timezone ====================
# زمان‌محلی سیستم (سرور و نمایش در پنل) — ترکیه: Europe/Istanbul
TZ=Europe/Istanbul
APP_TIMEZONE=Europe/Istanbul

# ==================== Debug ====================
DEBUG=false
DEBUG_WHATSAPP=false
DEBUG_DATABASE=false

# ==================== Performance ====================
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
REDIS_MAX_CONNECTIONS=50

# ==================== Webhooks (Optional) ====================
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_EVENTS=new_message,conversation_assigned,conversation_closed

# WhatsApp Cloud API webhook signature validation (recommended)
# Set Meta App Secret used to verify X-Hub-Signature-256
# WHATSAPP_CLOUD_APP_SECRET=

# ==================== Third-party Integrations (Optional) ====================

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Webhook
SLACK_WEBHOOK_URL=

# Google Analytics
GA_TRACKING_ID=

# Sentry (Error Tracking)
SENTRY_DSN=

# ==================== Mobile App (Future) ====================
MOBILE_APP_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false

# ==================== Advanced Settings ====================

# Auto-close inactive conversations (in hours)
AUTO_CLOSE_INACTIVE_HOURS=72

# Customer satisfaction survey
ENABLE_CSAT_SURVEY=true
CSAT_TRIGGER_ON_CLOSE=true

# Working hours (24-hour format)
WORKING_HOURS_START=09:00
WORKING_HOURS_END=18:00
WORKING_DAYS=1,2,3,4,5

# Out of office message
OUT_OF_OFFICE_MESSAGE=متأسفانه الان خارج از ساعات کاری هستیم. پیام شما ثبت شد و در اولین فرصت پاسخ داده خواهد شد.

# ==================== Development Only ====================
# DEVELOPMENT=true
# MOCK_WHATSAPP=true
# SEED_DATABASE=true
